{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "NGK",
	"scopeName": "source.ngk",
	"patterns": [
		{ "include": "#hex-colour-value" },
		{ "include": "#comments" },
		{ "include": "#section-headers" },
		{ "include": "#option-keys" },
		{ "include": "#particle-tunables" },
		{ "include": "#animation-keys" },
		{ "include": "#font-directives" },
		{ "include": "#commands" },
		{ "include": "#group-block" },
		{ "include": "#loop-block" },
		{ "include": "#run-block" },
		{ "include": "#macro-call" },
		{ "include": "#cue-reference" },
		{ "include": "#particle-types" },
		{ "include": "#modifiers" },
		{ "include": "#strings" },
		{ "include": "#numbers" }
	],
	"repository": {
		"hex-colour-value": {
			"comment": "A value such as `TextColour = #FF8800`: a colour, not a comment.",
			"match": "(=)\\s*(#(?:[0-9A-Fa-f]{6}|[0-9A-Fa-f]{3}))(?![0-9A-Za-z_])",
			"captures": {
				"2": { "name": "constant.other.colour.ngk" }
			}
		},
		"comments": {
			"match": "#.*$",
			"name": "comment.line.number-sign.ngk"
		},
		"section-headers": {
			"match": "^\\s*\\[(Options|Preload|Commands|Macro|Cue|Hotkeys|RevyData|Structure|Display|(?i:backstage)|(?i:animations?)|Particle\\.[A-Z]+)\\]\\s*$",
			"captures": {
				"1": { "name": "entity.name.section.ngk" }
			},
			"name": "meta.section.ngk"
		},
		"commands": {
			"match": "(?<![A-Za-z0-9_])(text|textCont|textbf|textit|textbfCont|textitCont|textD|clear|clearText|clearImages|clearAll|clearCountdown|play|stop|stopParticleCont|show|comment|countdown|typewrite)(?![A-Za-z0-9_])",
			"name": "keyword.control.ngk"
		},
		"group-block": {
			"match": "(?<![A-Za-z0-9_])(group)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "keyword.control.group.ngk" },
				"2": { "name": "entity.name.tag.group.ngk" }
			}
		},
		"loop-block": {
			"match": "(?<![A-Za-z0-9_])(loop)\\s*\\(",
			"captures": {
				"1": { "name": "keyword.control.loop.ngk" }
			}
		},
		"run-block": {
			"match": "(?<![A-Za-z0-9_])(run)(?=\\s*\\{)",
			"captures": {
				"1": { "name": "keyword.control.run.ngk" }
			}
		},
		"macro-call": {
			"match": "(?<![A-Za-z0-9_])(macro)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "keyword.control.macro.ngk" },
				"2": { "name": "entity.name.function.macro.ngk" }
			}
		},
		"option-keys": {
			"match": "(?i)^\\s*(fontsize|fontbolditalic|fontbold|fontitalic|font|textoutline|capitalize|cap|audiofade|backgroundcolou?r|bc|textcolou?r|subtitleitalic|subtitlecolou?r|subtitletransparency|subtitleposy|fixedtextcent(?:re|er)|disabletextoutline|transparentbackground|name|expectedtime|actors|ninjas|url|enabled)(?=\\s*=)",
			"captures": {
				"1": { "name": "variable.parameter.option.ngk" }
			}
		},
		"particle-tunables": {
			"comment": "Per-particle-type tunables in [Options], e.g. `RAIN.SPEED = 2`.",
			"match": "(?i)^\\s*((?:rain|snow|confetti|rise|scatter|brownian|oscillation|orbit|noise|lifecurve)\\.(?:speed|density|dens|x\\.dist|vx\\.dist|vy\\.dist|vx|vy|x))(?=\\s*=)",
			"captures": {
				"1": { "name": "variable.parameter.option.ngk" }
			}
		},
		"animation-keys": {
			"comment": "Keys inside an [Animation] block. `show =` / `text =` are keys here, not commands.",
			"match": "(?i)^\\s*(show|text|path|duration|repeat|for|every|randomx|randomy|layer|size)(?=\\s*=)(?:\\s*=\\s*(forever)(?![A-Za-z0-9_]))?",
			"captures": {
				"1": { "name": "variable.parameter.animation.ngk" },
				"2": { "name": "constant.language.ngk" }
			}
		},
		"font-directives": {
			"comment": "`use FONT` / `use default` and `fontSize N` / `fontSize default` rows.",
			"match": "^\\s*(use|fontSize)(?![A-Za-z0-9_])(?!\\s*=)(?:\\s+(default)(?![A-Za-z0-9_]))?",
			"captures": {
				"1": { "name": "keyword.control.directive.ngk" },
				"2": { "name": "constant.language.ngk" }
			}
		},
		"cue-reference": {
			"comment": "A trailing `\\\\Name` claiming a [Cue] note.",
			"match": "(?<=\\s)(\\\\)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:#.*)?$)",
			"captures": {
				"1": { "name": "punctuation.definition.cue.ngk" },
				"2": { "name": "entity.name.tag.cue.ngk" }
			}
		},
		"particle-types": {
			"match": "(?<![A-Za-z0-9_])(RAIN|SNOW|CONFETTI|RISE|SCATTER|BROWNIAN|OSCILLATION|ORBIT|NOISE|LIFECURVE|GHOST|STRETCH|GLOW|UNIFORM|NORMAL|LOGNORMAL|BINOMIAL|BERNOULLI|GAMMA)(?![A-Za-z0-9_])",
			"name": "constant.language.particle.ngk"
		},
		"modifiers": {
			"match": "(?<![A-Za-z0-9_])(colour|color|trans|rotate|move|pathMove|spin|pos|size|scale|layer|particle|randomImages|randomSize|random|bold|it|trail|trailGlow|bounce)(?=\\s*\\()",
			"name": "support.function.modifier.ngk"
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.ngk",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.ngk", "match": "\\\\." }
					]
				},
				{
					"name": "string.quoted.single.ngk",
					"begin": "'",
					"end": "'",
					"patterns": [
						{ "name": "constant.character.escape.ngk", "match": "\\\\." }
					]
				},
				{
					"name": "string.quoted.other.ngk",
					"begin": "´",
					"end": "´",
					"patterns": [
						{ "name": "constant.character.escape.ngk", "match": "\\\\." }
					]
				}
			]
		},
		"numbers": {
			"match": "(?<![A-Za-z0-9_])-?[0-9]+(\\.[0-9]+)?(?![A-Za-z0-9_])",
			"name": "constant.numeric.ngk"
		}
	}
}
