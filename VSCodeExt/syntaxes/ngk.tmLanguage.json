{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "NGK",
	"scopeName": "source.ngk",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#section-headers" },
		{ "include": "#commands" },
		{ "include": "#group-block" },
		{ "include": "#loop-block" },
		{ "include": "#run-block" },
		{ "include": "#macro-call" },
		{ "include": "#option-keys" },
		{ "include": "#particle-types" },
		{ "include": "#modifiers" },
		{ "include": "#strings" },
		{ "include": "#numbers" }
	],
	"repository": {
		"comments": {
			"match": "#.*$",
			"name": "comment.line.number-sign.ngk"
		},
		"section-headers": {
			"match": "^\\s*\\[(Options|Preload|Commands|Macro|Cue|Hotkeys|RevyData|Structure|Display|(?i:backstage)|Particle\\.[A-Z]+)\\]\\s*$",
			"captures": {
				"1": { "name": "entity.name.section.ngk" }
			},
			"name": "meta.section.ngk"
		},
		"commands": {
			"match": "(?<![A-Za-z0-9_])(text|textCont|textbf|textit|textbfCont|textitCont|textD|clear|clearText|clearImages|clearAll|clearCountdown|play|stop|stopParticleCont|show|comment|countdown|typewrite)(?![A-Za-z0-9_])",
			"name": "keyword.control.ngk"
		},
		"group-block": {
			"match": "(?<![A-Za-z0-9_])(group)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "keyword.control.group.ngk" },
				"2": { "name": "entity.name.tag.group.ngk" }
			}
		},
		"loop-block": {
			"match": "(?<![A-Za-z0-9_])(loop)\\s*\\(",
			"captures": {
				"1": { "name": "keyword.control.loop.ngk" }
			}
		},
		"run-block": {
			"match": "(?<![A-Za-z0-9_])(run)(?=\\s*\\{)",
			"captures": {
				"1": { "name": "keyword.control.run.ngk" }
			}
		},
		"macro-call": {
			"match": "(?<![A-Za-z0-9_])(macro)\\s+([A-Za-z_][A-Za-z0-9_]*)",
			"captures": {
				"1": { "name": "keyword.control.macro.ngk" },
				"2": { "name": "entity.name.function.macro.ngk" }
			}
		},
		"option-keys": {
			"match": "(?i)^\\s*(fontsize|fontbolditalic|fontbold|fontitalic|font|textoutline|capitalize|cap|audiofade|backgroundcolou?r|bc|textcolou?r|subtitleitalic|subtitlecolou?r|subtitletransparency|subtitleposy|fixedtextcent(?:re|er)|name|expectedtime|actors|ninjas|url|enabled)(?=\\s*=)",
			"captures": {
				"1": { "name": "variable.parameter.option.ngk" }
			}
		},
		"particle-types": {
			"match": "(?<![A-Za-z0-9_])(RAIN|SNOW|CONFETTI|RISE|SCATTER|BROWNIAN|OSCILLATION|ORBIT|NOISE|LIFECURVE|GHOST|STRETCH|GLOW|UNIFORM|NORMAL|LOGNORMAL|BINOMIAL|BERNOULLI|GAMMA)(?![A-Za-z0-9_])",
			"name": "constant.language.particle.ngk"
		},
		"modifiers": {
			"match": "(?<![A-Za-z0-9_])(colour|color|trans|rotate|move|pathMove|spin|pos|size|scale|layer|particle|randomImages|randomSize|random|bold|it|trail|trailGlow|bounce)(?=\\s*\\()",
			"name": "support.function.modifier.ngk"
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.ngk",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{ "name": "constant.character.escape.ngk", "match": "\\\\." }
					]
				},
				{
					"name": "string.quoted.single.ngk",
					"begin": "'",
					"end": "'",
					"patterns": [
						{ "name": "constant.character.escape.ngk", "match": "\\\\." }
					]
				},
				{
					"name": "string.quoted.other.ngk",
					"begin": "´",
					"end": "´",
					"patterns": [
						{ "name": "constant.character.escape.ngk", "match": "\\\\." }
					]
				}
			]
		},
		"numbers": {
			"match": "(?<![A-Za-z0-9_])-?[0-9]+(\\.[0-9]+)?(?![A-Za-z0-9_])",
			"name": "constant.numeric.ngk"
		}
	}
}
